# Low-privilege app role (NOBYPASSRLS) — used for all regular request traffic.
# Row-level security actually applies to this connection.
DATABASE_URL=postgresql://ems_app.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Owner/superuser role — used only for schema DDL (init_db() on boot, Alembic
# migrations). Falls back to DATABASE_URL if unset, for environments that
# haven't split the two roles yet.
ADMIN_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Optional: a separate Postgres used only by the test suite
# (tests/conftest.py prefers these over the two above when set) — a plain
# local Postgres works fine (e.g. postgresql://ems_app:PW@localhost:5433/
# ems_test, kept off the default 5432 to avoid colliding with any other
# local Postgres instance/project); doesn't need to be Supabase at all.
# Provision it once by dumping prod's schema (pg_dump --schema-only
# --no-owner --no-privileges -n public) and restoring into the new
# database, recreating the ensure_rls event trigger by hand (pg_dump
# doesn't carry event triggers across), granting the ems_app role the same
# DML privileges as prod, enabling SSL (db.py hardcodes sslmode=require),
# then `alembic stamp head` — see CLAUDE.md for the full recipe and its
# gotchas. Falls back to DATABASE_URL/ADMIN_DATABASE_URL (i.e. runs
# against prod) if unset.
TEST_DATABASE_URL=
TEST_ADMIN_DATABASE_URL=

JWT_SECRET=replace-with-a-long-random-string

# Encrypts institutions' own Anthropic API keys at rest (BYOK — see
# core/secrets_encryption.py, routers/assistant.py's settings endpoints).
# Same setup as JWT_SECRET: any long random string, not a pre-formatted key.
# Required — the app will not start without it once any institution has
# saved a BYOK key, and existing encrypted keys become undecryptable if
# this value ever changes.
TENANT_SECRETS_ENCRYPTION_KEY=replace-with-a-long-random-string

# Anthropic API key for the AI assistant chatbot (routers/assistant.py).
# This is now only the platform *default*, used for any institution that
# hasn't configured its own key (BYOK, Settings -> AI Assistant, hr_manager
# only). Optional — leave empty and institutions without their own key
# simply see the assistant as unavailable, rather than the app failing to
# start. Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Sentry error tracking (optional). Get DSN from https://sentry.io/
# Leave empty to disable error tracking.
SENTRY_DSN=

# Sentry sampling rates (0.0-1.0). Adjust based on traffic volume.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.01

# Environment name (development/staging/production)
ENVIRONMENT=development

# Redis connection for async task queue (Celery broker/backend)
# Default: redis://localhost:6379/0 (local development)
# For production: redis://[:password]@host:port/db
REDIS_URL=redis://localhost:6379/0

# Cloudflare Turnstile (optional) — bot/spam protection on the public job
# application form (routers/public_careers.py), the only unauthenticated
# write endpoint in this app. Leave both empty to skip CAPTCHA verification
# entirely (fine for local dev/testing); set both before relying on this
# feature with real public traffic. Get a free site+secret key pair from
# https://dash.cloudflare.com/ → Turnstile — no payment, just an account.
# TURNSTILE_SITE_KEY is safe to expose to the browser (sent to the public
# apply form as-is); TURNSTILE_SECRET_KEY must stay server-side only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Serve Swagger UI / ReDoc / OpenAPI schema (leave unset in production)
ENABLE_API_DOCS=true
